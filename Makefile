# luci-app-oxidns-plus is an ADD-ON for an existing OxiDNS runtime.
# It deliberately does NOT ship the OxiDNS core binary, does NOT own
# /etc/oxidns/config.yaml and does NOT overlap any file of
# NetForgeCN/luci-app-oxidns. Install the core first (via luci-app-oxidns
# or manually), then install this package.
#

include $(TOPDIR)/rules.mk

PKG_NAME:=luci-app-oxidns-plus
PKG_VERSION:=0.1.0
PKG_RELEASE:=1

PKG_LICENSE:=GPL-3.0-or-later
PKG_LICENSE_FILES:=LICENSE
PKG_MAINTAINER:=NetForgeCN

LUCI_TITLE:=OxiDNS Plus - cache warming, DHCP hostnames and diagnostics
LUCI_DEPENDS:=+luci-base +rpcd +jsonfilter +bind-dig
LUCI_PKGARCH:=all

# Note on dependencies:
#   +oxidns-core is intentionally NOT listed. The upstream luci-app-oxidns
#   workflow installs the core at runtime from a release archive / upload,
#   not necessarily through opkg/apk. A hard package dependency would make
#   this add-on uninstallable on exactly those systems. README documents the
#   runtime requirement instead.
#   +bind-dig is required by the warmer (busybox nslookup cannot target a
#   custom port such as 5333).

define Package/luci-app-oxidns-plus/description
  Adds a LuCI page, UCI settings, an init script and three helper scripts on
  top of an existing OxiDNS 1.7.x installation: periodic cache warming from
  an editable domain list, DHCP lease to local hostname mapping, upstream
  latency diagnostics, and a guarded lazy_cache_ttl tuning action. All state
  lives in its own UCI package and its own files; nothing in the base
  luci-app-oxidns package is modified or overwritten.
endef

define Package/luci-app-oxidns-plus/conffiles
/etc/config/oxidnsplus
/etc/oxidns/warm.list
endef

define Package/luci-app-oxidns-plus/postinst
#!/bin/sh
ROOT="$${IPKG_INSTROOT:-}"

# Files created through the GitHub API lose their executable bit (git mode
# 100644), and some build systems do not preserve it from the source tree.
# Do this BEFORE the IPKG_INSTROOT early-exit so the fix also lands in images
# built offline with an image builder, not just in live opkg/apk installs.
for f in \
	/etc/init.d/oxidnsplus \
	/usr/libexec/rpcd/luci.oxidnsplus \
	/usr/libexec/oxidnsplus-warm.sh \
	/usr/libexec/oxidnsplus-dhcp-hosts.sh \
	/usr/libexec/oxidnsplus-diagnose.sh ; do
	[ -f "$$ROOT$$f" ] && chmod 755 "$$ROOT$$f"
done

# The DHCP hosts file must exist at start-up: hosts_system.files points at it,
# and OxiDNS reads those files when the config is loaded. Also needed at image
# build time, hence before the early-exit.
if [ ! -f "$$ROOT/etc/oxidns/dhcp-hosts" ]; then
	mkdir -p "$$ROOT/etc/oxidns"
	printf '# Generated by luci-app-oxidns-plus. Do not edit by hand.\n' > "$$ROOT/etc/oxidns/dhcp-hosts"
fi

[ -n "$$ROOT" ] && exit 0

# Keep user-editable files across sysupgrade.
if [ -f /etc/sysupgrade.conf ]; then
	for entry in /etc/config/oxidnsplus /etc/oxidns/warm.list /etc/oxidns/dhcp-hosts; do
		grep -qxF "$$entry" /etc/sysupgrade.conf 2>/dev/null || \
			echo "$$entry" >> /etc/sysupgrade.conf
	done
fi

rm -f /tmp/luci-indexcache* 2>/dev/null || true
rm -rf /tmp/luci-modulecache/* 2>/dev/null || true
if [ -d /www/luci-static/resources/view/oxidnsplus ]; then
	find /www/luci-static/resources/view/oxidnsplus -type f -name '*.js' -exec touch {} + 2>/dev/null || true
fi
if [ -x /etc/init.d/rpcd ]; then
	/etc/init.d/rpcd restart >/dev/null 2>&1 || true
fi
# Install/reinstall the cron block when the service is already enabled.
if [ -x /etc/init.d/oxidnsplus ] && /etc/init.d/oxidnsplus enabled >/dev/null 2>&1; then
	/etc/init.d/oxidnsplus start >/dev/null 2>&1 || true
fi
exit 0
endef

define Package/luci-app-oxidns-plus/postrm
#!/bin/sh
[ -n "$${IPKG_INSTROOT:-}" ] && exit 0
# Remove our cron block so we do not leave jobs pointing at removed scripts.
if [ -f /etc/crontabs/root ]; then
	awk '
		/^# oxidns-plus:begin$/ { skip = 1; next }
		/^# oxidns-plus:end$/   { skip = 0; next }
		!skip { print }
	' /etc/crontabs/root > /etc/crontabs/root.tmp && \
		mv /etc/crontabs/root.tmp /etc/crontabs/root
	[ -x /etc/init.d/cron ] && /etc/init.d/cron restart >/dev/null 2>&1 || true
fi
rm -rf /tmp/luci-modulecache/* 2>/dev/null || true
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart >/dev/null 2>&1 || true
exit 0
endef

include $(TOPDIR)/feeds/luci/luci.mk
